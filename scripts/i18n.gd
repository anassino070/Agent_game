# i18n.gd — Autoload "I18n". Vertaallaag voor alle speler-zichtbare tekst.
#
# OPZET: de NEDERLANDSE string is zelf de sleutel. Dus in de code staat
# `T("Naar events →")` en de tabel hieronder mapt die naar het Engels. Waarom
# zo, en niet met abstracte sleutels als `EVENTS_NEXT`:
#   * de broncode blijft leesbaar (je ziet meteen wat er op het scherm komt);
#   * een ontbrekende vertaling valt automatisch terug op het Nederlands
#     i.p.v. een lege string of een sleutelnaam te tonen;
#   * er is geen aparte sleutel-administratie die uit de pas kan lopen.
#
# BELANGRIJK bij format-strings: vertaal ALTIJD vóór het interpoleren, dus
# `T("Seizoen %d/%d") % [a, b]` en NIET `T("Seizoen %d/%d" % [a, b])` — dat
# laatste zoekt een al-ingevulde string op en mist dus altijd. De placeholders
# (%s, %d) moeten in de vertaling in dezelfde ORDE staan, want GDScript's
# %-operator kent geen genummerde argumenten.
extends Node

const DEFAULT_LANG := "nl"

const LANGS := {
	"nl": "Nederlands",
	"en": "English",
	"fr": "Français",
	"es": "Español",
	"de": "Deutsch",
	"ar": "العربية",
}

# Talen die van rechts naar links lopen. main.gd zet hierop de layout_direction
# van de root en spiegelt de twee zwevende knoppen; Godot regelt de rest van de
# container-ordening en tekstuitlijning dan zelf. De → -pijlen zitten IN de
# vertalingen (het Arabisch gebruikt ←), dus die hoeven geen code.
const RTL_LANGS := {"ar": true}

var _lang := DEFAULT_LANG
var _table: Dictionary = {}


func _ready() -> void:
	_table = {
		"en": _table_en(), "fr": _table_fr(),
		"es": _table_es(), "de": _table_de(), "ar": _table_ar(),
	}
	# I18n staat in project.godot NA Meta geregistreerd, dus Meta bestaat hier
	# gegarandeerd al en we kunnen de opgeslagen taalkeuze direct oppikken.
	refresh_from_settings()


func refresh_from_settings() -> void:
	set_lang(str(Meta.setting("lang")))


func set_lang(l: String) -> void:
	_lang = l if LANGS.has(l) else DEFAULT_LANG


func lang() -> String:
	return _lang


func lang_name(l: String) -> String:
	return str(LANGS.get(l, l))


func is_rtl() -> bool:
	return RTL_LANGS.has(_lang)


# Het letterrooster van de anagramjacht. Was hardgecodeerd A-Z, maar dat werkt
# alleen zolang elke taal het Latijnse alfabet gebruikt.
#
# Arabisch: de 28 basisletters PLUS ة (taa marbuta) en ء (hamza). Die twee zijn
# geen luxe — 18 van de 44 woorden in WORD_BANK_AR eindigen op ة, en zonder die
# toets is het antwoord letterlijk niet in te voeren. De alif-varianten أ إ آ en
# de ى blijven er bewust WEL buiten, en de woordenlijst vermijdt ze daarom ook.
# Dezelfde discipline als "geen accenten" bij de Latijnse lijsten: elke letter
# in een antwoord moet op het toetsenbord staan.
#
# 30 letters bij 5 kolommen = precies 6 rijen, gelijk aan de 26 Latijnse.
const KEYBOARD_LATIN := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const KEYBOARD_AR := "ابتثجحخدذرزسشصضطظعغفقكلمنهويةء"


func keyboard_letters() -> Array:
	var src := KEYBOARD_AR if _lang == "ar" else KEYBOARD_LATIN
	var out: Array = []
	for i in range(src.length()):
		out.append(src[i])
	return out


