func word_bank(nl_bank: Array) -> Array:
	match _lang:
		"en": return WORD_BANK_EN
		"fr": return WORD_BANK_FR
		_: return nl_bank


func club_names(nl_names: Array) -> Array:
	match _lang:
		"en": return CLUB_NAMES_EN
		"fr": return CLUB_NAMES_FR
		_: return nl_names


# De vertaalfunctie. Kort van naam omdat hij honderden keren voorkomt.
func T(nl: String) -> String:
	if _lang == DEFAULT_LANG:
		return nl
	var t: Dictionary = _table.get(_lang, {})
	return str(t.get(nl, nl))


