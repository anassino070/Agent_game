	d["\"Heeft u daar een sluitende verklaring voor?\""] = "\"Do you have a watertight explanation for that?\""
	d["\"Is dit niet gewoon het begin van het einde voor hem hier?\""] = "\"Is this not simply the beginning of the end for him here?\""
	d["\"Durft u te beweren dat dit toeval is?\""] = "\"Do you dare claim this is a coincidence?\""
	d["\"Houdt u ons voor de gek, of speelt hij echt zijn laatste wedstrijden hier?\""] = "\"Are you having us on, or is he really playing his last matches here?\""
	d["\"Wordt het nu niet eens tijd voor eerlijkheid?\""] = "\"Is it not about time for some honesty?\""
	d["\"Wil hij eigenlijk weg bij deze club?\""] = "\"Does he actually want to leave this club?\""
	d["\"Wat heeft hij te zeggen tegen de fans die vanavond boe riepen?\""] = "\"What does he have to say to the fans who booed tonight?\""
	d["\"Wat zou hij nu tegen zichzelf zeggen, denkt u?\""] = "\"What would he say to himself right now, do you think?\""
	d["\"Gonst het nu al in de kleedkamer over zijn toekomst?\""] = "\"Is the dressing room already buzzing about his future?\""
